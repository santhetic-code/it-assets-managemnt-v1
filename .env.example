# --- FRONTEND CONFIG ---
APP_ENV=development
USE_MOCK=true
BACKEND_INTERNAL_URL=http://backend:8001

# --- BACKEND CONFIG ---
# Gunakan sqlite untuk dev, ganti ke postgresql+psycopg://... saat produksi
DATABASE_URL=sqlite:///./itam_dev.db
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=itam_super_secret
POSTGRES_DB=itam_pro_db
JWT_SECRET_KEY=ganti-dengan-secret-key-panjang-32-karakter
FERNET_SECRET_KEY=ganti-dengan-fernet-key-base64-32-bytes
