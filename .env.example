# ==========================================
# KONFIGURASI LINGKUNGAN ITAM PRO
# ==========================================
# APP_ENV: 'dev' untuk pengembangan lokal, 'production' untuk server rilis.
APP_ENV=dev

# USE_MOCK: 'true' untuk menggunakan data palsu (backend tidak dipakai).
# HARUS 'false' jika APP_ENV=production.
USE_MOCK=true

# [PERINGATAN] NILAI CONTOH DI BAWAH INI TIDAK BOLEH DIPAKAI DI PRODUCTION!
BACKEND_INTERNAL_URL=http://backend:8001

# Cara membuat JWT Secret: `openssl rand -hex 32`
JWT_SECRET_KEY=rahasia_ganti_di_produksi

# Cara membuat Fernet Key: jalankan di Python `from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())`
FERNET_MASTER_KEY=rahasia_ganti_di_produksi

# Database 
POSTGRES_PASSWORD=rahasia
