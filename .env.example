# --- PENGATURAN LINGKUNGAN ---
# APP_ENV=dev (default) atau APP_ENV=production. Jika production, USE_MOCK wajib false.
APP_ENV=dev
USE_MOCK=true

# [PERINGATAN] NILAI CONTOH DI BAWAH INI TIDAK BOLEH DIPAKAI DI PRODUCTION!
BACKEND_INTERNAL_URL=http://backend:8001
JWT_SECRET_KEY=rahasia_ganti_di_produksi
FERNET_MASTER_KEY=rahasia_ganti_di_produksi

# --- PORT JARINGAN ---
FRONTEND_PORT=3000
REFLEX_BACKEND_PORT=8000
FASTAPI_PORT=8001

# --- KONFIGURASI DATABASE (POSTGRESQL / SQLITE) ---
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=itam_secret_password_change_me
POSTGRES_DB=itam_pro_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://itam_user:itam_secret_password_change_me@db:5432/itam_pro_db

# --- PARAMETER JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
