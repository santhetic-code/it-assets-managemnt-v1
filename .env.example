# ==============================================================================
# KONFIGURASI LINGKUNGAN IT ASSETS MANAGEMENT PRO (ITAM PRO)
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi.
# ==============================================================================

# --- MODE SUMBER DATA FRONTEND ---
# true  = Gunakan data in-memory dari frontend/itam_pro/services/mock/
# false = Hubungkan api_client.py ke FastAPI Backend (BACKEND_INTERNAL_URL)
USE_MOCK=true

# --- URL KOMUNIKASI INTERNAL CONTAINER ---
BACKEND_INTERNAL_URL=http://backend:8001
FRONTEND_PORT=3000
REFLEX_BACKEND_PORT=8000
FASTAPI_PORT=8001

# --- KONFIGURASI DATABASE (POSTGRESQL / SQLITE) ---
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=itam_secret_password_change_me
POSTGRES_DB=itam_pro_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://itam_user:itam_secret_password_change_me@db:5432/itam_pro_db

# --- KEAMANAN, JWT, & ENKRIPSI CREDENTIAL MANAGER (FERNET) ---
JWT_SECRET_KEY=replace_with_64_char_random_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
FERNET_MASTER_KEY=replace_with_32_url_safe_base64_encoded_bytes=
